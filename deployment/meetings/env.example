MEETINGS_ENABLED=true
MEETINGS_MODELS_DIR=/absolute/wsl/path/to/models
MEETINGS_OLLAMA_URL=http://host.docker.internal:11434
MEETINGS_OLLAMA_MODEL=gpt-oss:20b
MEETINGS_TRANSCRIBE_GPU_0=0
MEETINGS_TRANSCRIBE_GPU_1=1
MEETINGS_DIARIZE_GPU=2
MEETINGS_LANGUAGE=ru
MEETINGS_MAX_UPLOAD_BYTES=2147483648
MEETINGS_MAX_SECONDS=14400
MEETINGS_STAGE_TIMEOUT=21600
DISABLE_TELEMETRY=true
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Apply separately to the EXISTING Ollama process, not just these workers:
# CUDA_VISIBLE_DEVICES=3
# OLLAMA_NO_CLOUD=1
